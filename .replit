modules = ["python-3.12", "web"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "libxcrypt", "mupdf", "openjpeg", "swig", "xcbuild"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "navigator-requirements"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "navigator-regressions"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run uvicorn src.web:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "navigator-requirements"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --frozen python -m src.check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "navigator-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --frozen python -m unittest discover -s tests -v"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80
